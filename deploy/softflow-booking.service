[Unit]
Description=SoftFlow Telegram Booking Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=softflowbot
Group=softflowbot
WorkingDirectory=/opt/softflow-booking
EnvironmentFile=/opt/softflow-booking/.env
ExecStart=/opt/softflow-booking/.venv/bin/python app.py
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/softflow-booking/data

[Install]
WantedBy=multi-user.target
